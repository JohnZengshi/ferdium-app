{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignore": [".understand-anything"]
  },
  "formatter": {
    "enabled": false
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "ignore": ["build", "build-e2e", ".tmp", "coverage", "node_modules", "recipes", "*.json", "src/whatsapp-automation/api/generated", "src/agent-flow-cs/api/generated", ".understand-anything"],
    "rules": {
      "style": {
        "noNonNullAssertion": "off",
        "noInferrableTypes": "off",
        "noParameterAssign": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noUselessConstructor": "off",
        "noForEach": "off",
        "noBannedTypes": "off"
      },
      "suspicious": {
        "noEmptyInterface": "off",
        "noExplicitAny": "off",
        "noImplicitAnyLet": "off",
        "noArrayIndexKey": "off",
        "noThenProperty": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "noSvgWithoutTitle": "off"
      }
    }
  }
}
