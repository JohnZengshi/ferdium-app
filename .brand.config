# 品牌配置文件
# 用于自定义应用名称、标识符和元数据

# 应用名称配置
APP_NAME="AITALK"
APP_ID="com.lzxl.aitalk"
APP_DESCRIPTION="AITALK - AI-powered messaging platform"

# 作者和版权信息
APP_AUTHOR="LZXL"
APP_COPYRIGHT="LZXL"
APP_HOMEPAGE="https://lzxl.com"

# 桌面和协议名称
DESKTOP_NAME="aitalk.desktop"
PROTOCOL_SCHEME="aitalk"

# 输出文件名模板
# macOS: ${APP_NAME}-mac-${version}-${arch}.dmg
# 示例: AITALK-mac-7.1.3-nightly.3-x64.dmg
