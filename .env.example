# === Ferdium 服务器 ===
# 服务器覆盖（优先于 settings.json）
# "local" 表示本地服务器，或填写完整 URL 如 "https://api.ferdium.org"
FERDIUM_SERVER=local

# === WhatsApp AI Gateway ===
WA_AKG_BASE=http://10.0.0.228:3333

# localStorage 键名（非必要不修改）
# API_KEY_KEY=whatsapp-api-key
# API_KEY_STORAGE_KEY=whatsappAutomationApiKey

# === 开发模式 ===
# 设为 "1" 强制开启开发者模式（覆盖自动检测）
# ELECTRON_IS_DEV=1

# 开发模式下强制使用指定 API 后端（二选一）
# USE_LOCAL_API=1
# USE_LIVE_API=1

# 调试日志过滤（如 "Ferdium:*" 全部，"Ferdium:auth" 仅认证）
# DEBUG=Ferdium:*

# GitHub Token，用于下载 Recipe（可选，避免频率限制）
# GITHUB_AUTH_TOKEN=ghp_xxxxxxxxxxxx

# === 平台覆盖 ===
# 自定义数据目录（覆盖系统默认路径）
# FERDIUM_APPDATA_DIR=/path/to/data

# Windows 便携模式（自动检测，不要手动设置）
# PORTABLE_EXECUTABLE_FILE=
# PORTABLE_EXECUTABLE_DIR=

# Linux 会话类型（自动检测）
# XDG_SESSION_TYPE=wayland
